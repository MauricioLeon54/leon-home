[Unit]
Description=LEÓN Home network inventory pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/leon-home/current/inventory/leon-netmap
User=leon-netmap
Group=leon-netmap
EnvironmentFile=/etc/leon-home/inventory.env
StateDirectory=leon-netmap
StateDirectoryMode=0755
TimeoutStartSec=90
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
CapabilityBoundingSet=
