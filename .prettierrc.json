{
  "printWidth": 200,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "quoteProps": "consistent",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "overrides": [
    { "files": "*.html", "options": { "printWidth": 120, "singleQuote": false } },
    { "files": "*.css", "options": { "printWidth": 100 } }
  ]
}
